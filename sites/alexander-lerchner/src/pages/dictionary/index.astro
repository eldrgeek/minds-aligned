---
import Base from '../../layouts/Base.astro';
import papersData from '../../data/papers.json';

type Paper = {
  slug: string;
  title?: string;
  year?: string | number | null;
  journal?: string | null;
  doi_url?: string | null;
  link?: string | null;
};

const papers = papersData as Paper[];
const normalise = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

/* Prefer the version of record over the preprint duplicate when both are indexed. */
const byTitle = new Map<string, Paper>();
for (const p of papers) {
  const k = normalise(p.title || '');
  const existing = byTitle.get(k);
  const isPreprint = /arxiv|biorxiv|zenodo/i.test(String(p.journal || ''));
  if (!existing || (!isPreprint && /arxiv|biorxiv|zenodo/i.test(String(existing.journal || '')))) {
    byTitle.set(k, p);
  }
}

/* Every entry below is a standard definition of a term as the field uses it, paired
 * with a paper IN THIS ARCHIVE where Lerchner works with it. The definitions are not
 * quotations of Lerchner and are not attributed to him; the citation is the claim. */
const entries = [
  {
    term: 'Representation',
    body:
      'What a system carries about the world internally — the quantity every phase of this archive is about, whether it lives in a cortical population, a latent vector, an object slot, or an agent’s policy.',
    see: 'Towards a Definition of Disentangled Representations',
  },
  {
    term: 'Disentangled representation',
    body:
      'A representation in which separate, independent factors of variation in the data occupy separate parts of the code — so changing one dimension changes one thing about the reconstruction. Widely used before it was defined; this corpus contains the paper that attempts the definition.',
    see: 'Towards a Definition of Disentangled Representations',
  },
  {
    term: 'Variational autoencoder (VAE)',
    body:
      'A generative model that learns to compress data into a probability distribution over latent variables and reconstruct it, trained by maximizing a bound on the data likelihood (the ELBO). The substrate for the disentangling work here.',
    see: 'beta-VAE: Learning Basic Visual Concepts with a Constrained Variational Framework',
  },
  {
    term: 'β (beta)',
    body:
      'The single added coefficient that gives β-VAE its name: it weights the latent bottleneck term against reconstruction. Push it above one and the representation trades reconstruction detail for independent, interpretable factors — the whole result in one hyperparameter.',
    see: 'Understanding disentangling in $\\beta$-VAE',
  },
  {
    term: 'Factors of variation',
    body:
      'The independent generative causes behind a dataset — position, colour, scale, identity — that a disentangled model is supposed to recover without ever being told they exist.',
    see: 'Early Visual Concept Learning with Unsupervised Deep Learning',
  },
  {
    term: 'Compositionality',
    body:
      'The property that learned parts can be recombined into configurations never seen in training. SCAN pursues it hierarchically, on the conjecture that the world’s diversity "arises from a relatively small set of coherent rules".',
    see: 'SCAN: Learning Hierarchical Compositional Visual Concepts',
  },
  {
    term: 'Zero-shot transfer',
    body:
      'Performing in a domain the agent was never trained on, with no additional learning. DARLA’s claim is that a disentangled visual representation is what makes it possible — the agent "learns to see before learning to act".',
    see: 'DARLA: Improving Zero-Shot Transfer in Reinforcement Learning',
  },
  {
    term: 'Object-centric representation',
    body:
      'Representing a scene as a set of discrete entities with their own properties, rather than as one undifferentiated feature map — argued here to be "crucial for general intelligence" because it is what lets reasoning and imagination recombine parts.',
    see: 'MONet: Unsupervised Scene Decomposition and Representation',
  },
  {
    term: 'Scene decomposition',
    body:
      'Splitting an observation into its constituent objects without supervision — no segmentation labels, no object list. MONet does it per image; SIMONe does it over video while simultaneously inferring the viewpoint.',
    see: 'SIMONe: View-Invariant, Temporally-Abstracted Object Representations via Unsupervised Video Decomposition',
  },
  {
    term: 'Meta-reinforcement learning',
    body:
      'Learning to learn: training an agent so that it can adapt quickly to a new task drawn from a family, rather than mastering one fixed task. Alchemy exists because the field lacked benchmarks whose underlying structure was neither too simple nor too ill-defined.',
    see: 'Alchemy: A benchmark and analysis toolkit for meta-reinforcement learning agents',
  },
  {
    term: 'Instructable agent',
    body:
      'An agent that follows free-form natural-language instructions in an environment, rather than optimizing a fixed reward. The SIMA project trains such agents across many commercial 3D worlds.',
    see: 'Scaling Instructable Agents Across Many Simulated Worlds',
  },
  {
    term: 'Balanced cortical network',
    body:
      'A model of cortex in which strong excitation and strong inhibition roughly cancel, leaving neurons in a fluctuation-driven, irregular firing regime. The earliest work in this archive develops mean-field theories that solve such networks for firing rates and correlations together.',
    see: 'Response variability in balanced cortical networks',
  },
].map(e => ({
  ...e,
  paper: e.see ? byTitle.get(normalise(e.see)) : undefined,
  href: (e as { href?: string }).href,
  hrefLabel: (e as { hrefLabel?: string }).hrefLabel,
}));
---
<Base title="Dictionary" description="Concept dictionary for the Alexander Lerchner archive — disentangled representations, object-centric scene understanding, and embodied agents, each pointed at a paper in the corpus.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-12 pb-20">
    <p class="text-sm font-mono font-medium text-accent uppercase tracking-widest mb-3">Dictionary</p>
    <h1 class="font-serif text-3xl sm:text-4xl font-medium text-ink mb-4">Concept dictionary</h1>
    <p class="text-muted leading-relaxed mb-3">
      The vocabulary you need to read this archive. Each entry is the term as the field
      uses it, paired with a paper in the corpus where Lerchner works with it.
    </p>
    <p class="text-muted/70 text-sm leading-relaxed mb-10">
      The definitions are ours, written to get you into the papers &mdash; they are not
      quotations of Lerchner. The citation under each one is the part that is his.
    </p>

    <dl class="divide-y divide-border">
      {entries.map(e => (
        <div class="py-6">
          <dt class="font-serif text-xl font-medium text-ink mb-2">{e.term}</dt>
          <dd class="text-muted leading-relaxed text-sm mb-3">{e.body}</dd>
          {e.paper && (
            <dd class="text-xs">
              <span class="text-muted/60 font-mono uppercase tracking-wide mr-2">In the corpus</span>
              {(e.paper.doi_url || e.paper.link) ? (
                <a href={e.paper.doi_url || e.paper.link!} target="_blank" rel="noopener" class="text-accent hover:text-accent-mid">
                  {e.paper.title} ({e.paper.year}) ↗
                </a>
              ) : (
                <span class="text-muted">{e.paper.title} ({e.paper.year})</span>
              )}
            </dd>
          )}
          {!e.paper && e.href && (
            <dd class="text-xs">
              <span class="text-muted/60 font-mono uppercase tracking-wide mr-2">In the corpus</span>
              <a href={e.href} target="_blank" rel="noopener" class="text-accent hover:text-accent-mid">{e.hrefLabel} ↗</a>
            </dd>
          )}
        </div>
      ))}
    </dl>

    <a href="/corpus/" class="inline-block mt-10 text-accent hover:text-accent-mid text-sm font-medium">Browse the full corpus →</a>
  </div>
</Base>
