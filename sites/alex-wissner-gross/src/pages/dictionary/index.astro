---
import Base from '../../layouts/Base.astro';
import papersData from '../../data/papers.json';

type Paper = {
  slug: string;
  title?: string;
  year?: string | number | null;
  journal?: string | null;
  doi_url?: string | null;
  link?: string | null;
};

const papers = papersData as Paper[];
const normalise = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

/* Prefer the version of record over the preprint duplicate when both are indexed. */
const byTitle = new Map<string, Paper>();
for (const p of papers) {
  const k = normalise(p.title || '');
  const existing = byTitle.get(k);
  const isPreprint = /arxiv|biorxiv|zenodo/i.test(String(p.journal || ''));
  if (!existing || (!isPreprint && /arxiv|biorxiv|zenodo/i.test(String(existing.journal || '')))) {
    byTitle.set(k, p);
  }
}

/* Every entry below is a standard definition of a term as the field uses it, paired
 * with a paper IN THIS ARCHIVE where Wissner-Gross works with it. The definitions are not
 * quotations of Wissner-Gross and are not attributed to him; the citation is the claim. */
const entries = [
  {
    term: 'Causal entropic force',
    body:
      'A force, in the thermodynamic sense, that pushes a system toward states from which the greatest diversity of futures remains reachable within a finite time horizon. Proposed here as a formal physical relationship where earlier work had only "hinted at a possible deep connection between intelligence and entropy maximization".',
    see: 'Causal Entropic Forces',
  },
  {
    term: 'Causal path entropy',
    body:
      'The entropy computed not over the states a system might occupy now, but over the paths it might still take between now and a horizon. Maximizing it is what the causal entropic force does; the horizon is the parameter that makes it finite and computable.',
    see: 'Causal Entropic Forces',
  },
  {
    term: 'Time horizon',
    body:
      'How far ahead the futures are counted. It is the free parameter of the whole construction: too short and the behaviour is myopic, too long and it is intractable — the reason this archive’s AI host is called Horizon.',
    see: 'A Thermodynamic Model for Behavioral Intelligence',
  },
  {
    term: 'Dielectrophoresis',
    body:
      'The motion of a neutral particle in a non-uniform electric field, caused by the field inducing a dipole in it. Used in this corpus to assemble, reconfigure and disassemble silicon nanowires between electrodes — building structure with a field instead of a tool.',
    see: 'Dielectrophoretic reconfiguration of nanowire interconnects',
  },
  {
    term: 'Self-assembly',
    body:
      'Structure that forms from local interactions between components rather than from external placement. The bench work and the cellular-automata work are two views of the same interest.',
    see: 'Dielectrophoretic control of semiconductor nanostructure growth and assembly',
  },
  {
    term: 'Cellular automaton',
    body:
      'A grid of cells updating in lockstep by a local rule — a minimal model of pattern formation. This corpus takes the unusual step of studying *ensembles* of rules rather than single ones, because real biological and physical systems coexpress many rules at once.',
    see: 'Pattern Formation without Favored Local Interactions',
  },
  {
    term: 'Rule ensemble',
    body:
      'A collection of cellular-automaton rules applied together rather than one rule applied everywhere. The companion paper reports what it calls "the first known analysis" of the equally-weighted ensemble, where no local interaction is favoured — and finds pattern anyway.',
    see: 'Pattern Formation without Favored Local Interactions',
  },
  {
    term: 'Relativistic statistical arbitrage',
    body:
      'Trading two securities on geographically separated exchanges when the light-propagation delay between them is no longer negligible — so the optimal place to run the strategy is a physical location determined by the speed of light.',
    see: 'Relativistic statistical arbitrage',
  },
  {
    term: 'Participatory telerobotics',
    body:
      'Treating people carrying mobile devices as ad-hoc telerobots — generalising participatory sensing to include real-time teleoperation and telepresence.',
    see: 'Participatory telerobotics',
  },
  {
    term: 'Few-shot learning',
    body:
      'Learning a new task from very few examples. Invoked in this corpus for autonomy in contested environments, where prior approaches were limited by "the low survivability of available AI and machine-learning techniques in the face of novel situations".',
    see: 'Adaptive Online Learning for Human-Robot Teaming in Dynamic Environments',
  },
  {
    term: 'Variational graph autoencoder',
    body:
      'A generative model that learns compressed representations of graphs — entities as vertices, relationships as edges. The 2021 paper adds a sparsity bias so the learned representations suit sparse graphs.',
    see: 'Joint sparsity-biased variational graph autoencoders',
  },
  {
    term: 'Physical Superintelligence',
    body:
      'The company he founded and serves as Chief Scientist of, per his own site. The name is worth reading against this corpus: two decades of asking what physics already implies about intelligent behaviour.',
    see: null,
    href: 'https://www.alexwg.org/',
    hrefLabel: 'alexwg.org',
  },
].map(e => ({
  ...e,
  paper: e.see ? byTitle.get(normalise(e.see)) : undefined,
  href: (e as { href?: string }).href,
  hrefLabel: (e as { hrefLabel?: string }).hrefLabel,
}));
---
<Base title="Dictionary" description="Concept dictionary for the Alex Wissner-Gross archive — causal entropic forces, self-assembly, and intelligence as a physical process, each pointed at a paper in the corpus.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-12 pb-20">
    <p class="text-sm font-mono font-medium text-accent uppercase tracking-widest mb-3">Dictionary</p>
    <h1 class="font-serif text-3xl sm:text-4xl font-medium text-ink mb-4">Concept dictionary</h1>
    <p class="text-muted leading-relaxed mb-3">
      The vocabulary you need to read this archive. Each entry is the term as the field
      uses it, paired with a paper in the corpus where Wissner-Gross works with it.
    </p>
    <p class="text-muted/70 text-sm leading-relaxed mb-10">
      The definitions are ours, written to get you into the papers &mdash; they are not
      quotations of Wissner-Gross. The citation under each one is the part that is his.
    </p>

    <dl class="divide-y divide-border">
      {entries.map(e => (
        <div class="py-6">
          <dt class="font-serif text-xl font-medium text-ink mb-2">{e.term}</dt>
          <dd class="text-muted leading-relaxed text-sm mb-3">{e.body}</dd>
          {e.paper && (
            <dd class="text-xs">
              <span class="text-muted/60 font-mono uppercase tracking-wide mr-2">In the corpus</span>
              {(e.paper.doi_url || e.paper.link) ? (
                <a href={e.paper.doi_url || e.paper.link!} target="_blank" rel="noopener" class="text-accent hover:text-accent-mid">
                  {e.paper.title} ({e.paper.year}) ↗
                </a>
              ) : (
                <span class="text-muted">{e.paper.title} ({e.paper.year})</span>
              )}
            </dd>
          )}
          {!e.paper && e.href && (
            <dd class="text-xs">
              <span class="text-muted/60 font-mono uppercase tracking-wide mr-2">In the corpus</span>
              <a href={e.href} target="_blank" rel="noopener" class="text-accent hover:text-accent-mid">{e.hrefLabel} ↗</a>
            </dd>
          )}
        </div>
      ))}
    </dl>

    <a href="/corpus/" class="inline-block mt-10 text-accent hover:text-accent-mid text-sm font-medium">Browse the full corpus →</a>
  </div>
</Base>
